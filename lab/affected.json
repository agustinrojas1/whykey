{
  "_about": "Which lab scenarios a change can affect; read by tools/lab_select.py (CI: .github/workflows/lab.yml). Paths are repo-relative; globs use * (one path segment), ** (any depth) and ?. Order of evaluation per changed path: core (every scenario), then every matching rule (union), then ignore (no scenario), else every scenario (a path nobody mapped is never assumed safe). Rule scenario entries: a glob matched against scenario ids and lab/scenarios-relative paths (as lab/run.py --only); image:NAME (every scenario of that group image); @self (the changed scenario file); @env (every scenario of the environment named by the changed lab/envs/NAME.py); @image (the image named by a changed lab/images/NAME.Dockerfile; base means all); @family (the image holding the package family named by a changed lab/packages/FAMILY.*; base means all). An empty scenarios list means no lab scenario covers the file. Every glob must match at least one scenario, or lab_select.py refuses to run.",

  "shard_size": {
    "_about": "Largest number of selected scenarios in one CI shard, per group image (default for the rest). ceil(selected / size) shards: the full run gives vm 6 shards (62 scenarios, each boots a VM, so they are the slowest), tty 2 (83), and wayland, x11 and gnome one each.",
    "default": 60,
    "vm": 11
  },

  "core": [
    "src/main.rs",
    "src/lib.rs",
    "src/cli.rs",
    "src/report.rs",
    "src/key.rs",
    "src/xkb.rs",
    "src/command.rs",
    "src/recording.rs",
    "src/environment.rs",
    "src/registry.rs",
    "src/schema.rs",
    "src/style.rs",
    "src/util.rs",
    "src/bindings.rs",
    "src/capture.rs",
    "src/listen/**",
    "src/probe/**",
    "src/layers/mod.rs",
    "src/layers/inspection.rs",
    "src/layers/model.rs",
    "src/layers/compositor.rs",
    "src/extension_adapters.rs",
    "src/focus.rs",
    "src/runtime_readers.rs",
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain",
    "rust-toolchain.toml",
    "build.rs",
    "lab/run.py",
    "lab/driver.py",
    "lab/common.py",
    "lab/envs/__init__.py",
    "lab/envs/_*.py",
    "lab/vkbd.py",
    "lab/rdkbd.py",
    "lab/qkbd.py",
    "lab/xgrab.py",
    "lab/keylog.py",
    "lab/ttylog.py",
    "lab/termagent.py",
    "lab/images.json",
    "lab/affected.json",
    "lab/packages/_install.sh",
    "tools/lab_images.py",
    "tools/lab_select.py",
    ".github/workflows/lab.yml",
    ".github/workflows/lab-images.yml"
  ],

  "ignore": [
    "**/*.md",
    "docs/**",
    "packaging/**",
    "debian/**",
    "LICENSE",
    "whykey.1",
    "support-matrix.json",
    "tests/**",
    "tests/lab_replay.rs",
    "lab/recordings/**",
    "extensions/tests/**",
    "extensions/compositor/**",
    "extensions/whykey-vscode/**",
    "extensions/whykey-vscode-defaults.json",
    "tools/tests/**",
    "tools/generate_*.py",
    "tools/check_*.sh",
    "tools/arch_package_smoke.sh",
    "tools/assemble_source_archive.sh",
    "tools/clean_install_smoke.sh",
    "tools/differential_compare.py",
    "tools/differential_compare.sh",
    "tools/measure_perf_e1.py",
    "tools/baseline_manifest.json",
    "tools/rebuild_baseline.sh",
    ".github/workflows/ci.yml",
    ".github/workflows/release.yml",
    "lab/mutate.py",
    "lab/mutations.example.json"
  ],

  "rules": [
    {"paths": ["lab/scenarios/*/*.json"], "scenarios": ["@self"]},
    {"paths": ["lab/envs/*.py"], "scenarios": ["@env"]},
    {"paths": ["lab/packages/*.txt", "lab/packages/*.sh"], "scenarios": ["@family"]},
    {"paths": ["lab/images/*.Dockerfile"], "scenarios": ["@image"]},

    {"paths": ["src/layers/zellij.rs"], "scenarios": ["termapps/zellij-*"]},
    {"paths": ["src/layers/session.rs"], "scenarios": ["termapps/zellij-*", "tmux/*"]},
    {"paths": ["src/layers/tmux.rs"], "scenarios": ["tmux/*"]},
    {"paths": ["src/layers/screen.rs"], "scenarios": ["tmux/screen-*"]},
    {"paths": ["src/layers/sway.rs", "src/layers/tiling.rs"],
     "scenarios": ["sway/*", "i3/*", "capture/sway-*", "probe/sway-*", "probe/i3-*"]},
    {"paths": ["src/layers/i3.rs"], "scenarios": ["i3/*", "probe/i3-*"]},
    {"paths": ["src/sway_capture.rs"], "scenarios": ["sway/*", "capture/sway-*", "probe/sway-*"]},
    {"paths": ["src/layers/x11_grab.rs"], "scenarios": ["image:x11", "image:vm"]},
    {"paths": ["src/layers/x11.rs"], "scenarios": ["xbindkeys/*"]},
    {"paths": ["src/layers/sxhkd.rs"], "scenarios": ["sxhkd/*"]},
    {"paths": ["src/layers/openbox.rs"], "scenarios": ["openbox/*"]},
    {"paths": ["src/layers/mate.rs"], "scenarios": ["mate/*"]},
    {"paths": ["src/layers/xfce.rs"], "scenarios": ["xfce/*"]},
    {"paths": ["src/layers/programmable.rs"], "scenarios": ["awesome/*", "qtile/*", "xmonad/*"]},
    {"paths": ["src/layers/cinnamon.rs"], "scenarios": ["cinnamon/*"]},
    {"paths": ["src/layers/gsettings.rs"], "scenarios": ["cinnamon/*", "mate/*", "gnome/*", "gnome-shell/*"]},
    {"paths": ["src/layers/gnome.rs"], "scenarios": ["gnome/*", "gnome-shell/*"]},
    {"paths": ["src/layers/kde.rs"], "scenarios": ["kde/*", "kwin/*"]},
    {"paths": ["src/layers/niri.rs"], "scenarios": ["niri/*"]},
    {"paths": ["src/layers/wayfire.rs"], "scenarios": ["wayfire/*"]},
    {"paths": ["src/layers/labwc.rs"], "scenarios": ["labwc/*"]},
    {"paths": ["src/layers/dwl.rs"], "scenarios": ["dwl/*"]},
    {"paths": ["src/layers/herbstluftwm.rs", "src/layers/river.rs"], "scenarios": []},
    {"paths": ["src/ime.rs"], "scenarios": ["ime/*"]},
    {"paths": ["src/remapper/**"], "scenarios": ["remap/*"]},
    {"paths": ["src/layers/hyprland/**", "src/hyprland_capture.rs"],
     "scenarios": ["hyprland/*", "capture/hyprland-*", "probe/hyprland-*", "remap/*"]},
    {"paths": ["src/layers/shell.rs", "src/layers/shell/**", "src/layers/readline.rs"],
     "scenarios": ["shells/*", "tmux/*"]},
    {"paths": ["src/layers/application.rs"], "scenarios": ["termapps/*"]},
    {"paths": ["src/layers/terminal_app.rs", "src/layers/ghostty.rs"], "scenarios": ["terminals/*"]},
    {"paths": ["src/layers/terminal.rs", "src/layers/terminal_dispatch.rs"], "scenarios": ["image:tty"]},
    {"paths": ["src/extensions.rs"], "scenarios": ["emacs/*", "nvim/*"]},
    {"paths": ["extensions/whykey-emacs/**"], "scenarios": ["emacs/*"]},
    {"paths": ["extensions/whykey-nvim/**"], "scenarios": ["nvim/*"]}
  ]
}
