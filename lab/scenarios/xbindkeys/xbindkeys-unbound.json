{
  "id": "xbindkeys-unbound",
  "description": "a key with no xbindkeys binding reaches the focused client",
  "tier": "observed",
  "environment": "x11",
  "files": {"/root/.xbindkeysrc": ["\"touch /tmp/fired\"", "  Mod4 + Return"]},
  "x11": {
    "daemons": [{"argv": ["xbindkeys", "-n", "-f", "/root/.xbindkeysrc"], "ready_grab": [64, 36]}]
  },
  "probe": "x11",
  "actions": [{"xdotool": ["key", "Super_L+y"]}],
  "ground_truth": {"fired": {"file": "/tmp/fired"}, "delivered": "probe"},
  "whykey": {"args": ["super+y"], "layer": "X11 xbindkeys", "env": {"XDG_SESSION_TYPE": "x11"}}
}
