{
  "id": "hyprland-lua-code-key",
  "description": "a Lua hl.bind on code:28 (XKB keycode of T) fires for Super+T",
  "tier": "observed",
  "environment": "hyprland",
  "files": {
    "/root/.config/hypr/hyprland.lua": [
      "hl.bind(\"SUPER + code:28\", hl.dsp.exec_cmd(\"touch /tmp/fired\"), { description = \"Lab code\" })"
    ]
  },
  "probe": "wayland",
  "actions": [
    {
      "vkbd": [
        "super+t"
      ]
    }
  ],
  "ground_truth": {
    "fired": {
      "file": "/tmp/fired"
    },
    "delivered": "probe"
  },
  "whykey": {
    "args": [
      "super+t"
    ],
    "layer": "Hyprland",
    "detail": "Lab code"
  }
}
