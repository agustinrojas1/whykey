{
  "id": "hyprland-submap-active",
  "description": "a binding of the active submap fires while that submap is entered",
  "tier": "observed",
  "environment": "hyprland",
  "files": {
    "/root/.config/hypr/hyprland.conf": [
      "bind = SUPER, R, submap, lab",
      "submap = lab",
      "bind = , T, exec, touch /tmp/fired",
      "bind = , escape, submap, reset",
      "submap = reset"
    ]
  },
  "probe": "wayland",
  "actions": [
    {
      "vkbd": [
        "super+r",
        "t"
      ]
    }
  ],
  "ground_truth": {
    "fired": {
      "file": "/tmp/fired"
    },
    "delivered": "probe"
  },
  "whykey": {
    "args": [
      "t"
    ],
    "layer": "Hyprland",
    "detail": "exec touch /tmp/fired"
  }
}
