{
  "id": "hyprland-native-capture-lua",
  "description": "native Hyprland capture (Lua key hook, pass-through) observes Super+T while the Lua-config bind fires",
  "tier": "observed",
  "environment": "hyprland",
  "files": {
    "/root/.config/hypr/hyprland.lua": [
      "hl.bind(\"SUPER + T\", hl.dsp.exec_cmd(\"touch /tmp/fired\"), { description = \"Lab fire\" })"
    ]
  },
  "probe": "wayland",
  "actions": [
    {
      "vkbd": [
        "super+t"
      ]
    }
  ],
  "ground_truth": {
    "fired": {
      "file": "/tmp/fired"
    },
    "delivered": "probe"
  },
  "whykey": {
    "args": [
      "listen",
      "--pass-through",
      "--count",
      "1",
      "--timeout",
      "10"
    ],
    "run": "background",
    "ready": {
      "stderr": "Waiting for input"
    },
    "layer": "Hyprland",
    "combo": {
      "key": "T",
      "modifiers": 64
    },
    "detail": "Lab fire",
    "tty": true
  }
}
