{
  "id": "xfce-unbound",
  "description": "<Super>y has no xfce4-keyboard-shortcuts binding, so the key reaches the focused client; the <Super>Return binding is a live control set at runtime through xfconf",
  "tier": "observed",
  "environment": "x11",
  "x11": {
    "daemons": [
      {"argv": ["xfwm4"], "ready": "wm"},
      {"argv": ["xfsettingsd"], "ready_grab": [64, 27], "ready_timeout": 30}
    ]
  },
  "session_setup": [
    "xfconf-query -c xfce4-keyboard-shortcuts -n -p '/commands/custom/<Super>Return' -t string -s 'touch /tmp/ready' && sleep 1"
  ],
  "probe": "x11",
  "actions": [
    {"xdotool": ["keydown", "Super_L", "keydown", "y", "keyup", "y", "keyup", "Super_L"]}
  ],
  "ground_truth": {"fired": {"file": "/tmp/fired"}, "delivered": "probe"},
  "whykey": {
    "args": ["super+y"],
    "layer": "Xfce",
    "env": {"XDG_SESSION_TYPE": "x11", "XDG_CURRENT_DESKTOP": "XFCE"}
  }
}
