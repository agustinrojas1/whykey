{
  "id": "wayfire-bind-consumed-no-ipc",
  "description": "a [command] binding Super+T runs its command and Wayfire consumes the key, but ipc-rules is not enabled, so whykey cannot ask the running compositor; tolerated uncertainty from the config file alone",
  "tier": "observed",
  "environment": "wayfire",
  "files": {
    "/root/.config/wayfire.ini": [
      "[core]",
      "plugins = command",
      "",
      "[command]",
      "binding_terminal = <super> KEY_T",
      "command_terminal = touch /tmp/fired"
    ]
  },
  "probe": "wayland",
  "actions": [{"vkbd": ["super+t"]}],
  "ground_truth": {"fired": {"file": "/tmp/fired"}, "delivered": "probe"},
  "whykey": {
    "args": ["super+t"],
    "layer": "Wayfire",
    "accept": ["handled-uncertain"],
    "env": {"XDG_CURRENT_DESKTOP": "wayfire", "XDG_SESSION_TYPE": "wayland"}
  }
}
