{
  "id": "wayfire-bind-consumed",
  "description": "a [command] binding Super+T in wayfire.ini runs its command and Wayfire consumes the key; whykey asks the running compositor (ipc-rules) for its live option and confirms the command plugin is mapped into it",
  "tier": "observed",
  "environment": "wayfire",
  "files": {
    "/root/.config/wayfire.ini": [
      "[core]",
      "plugins = ipc ipc-rules command",
      "",
      "[command]",
      "binding_terminal = <super> KEY_T",
      "command_terminal = touch /tmp/fired"
    ]
  },
  "probe": "wayland",
  "actions": [{"vkbd": ["super+t"]}],
  "ground_truth": {"fired": {"file": "/tmp/fired"}, "delivered": "probe"},
  "whykey": {
    "args": ["super+t"],
    "layer": "Wayfire",
    "env": {"XDG_CURRENT_DESKTOP": "wayfire", "XDG_SESSION_TYPE": "wayland"}
  }
}
