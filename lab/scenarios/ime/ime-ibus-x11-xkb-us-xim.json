{
  "id": "ime-ibus-x11-xkb-us-xim",
  "description": "IBus with the xkb:us::eng engine active for a focused XIM client (xterm) passes the key unchanged",
  "tier": "observed",
  "environment": "ime",
  "ime": {
    "daemon": "ibus",
    "session": "x11",
    "client": "xterm",
    "env": {
      "GTK_IM_MODULE": "ibus",
      "QT_IM_MODULE": "ibus",
      "XMODIFIERS": "@im=ibus"
    },
    "engine": {
      "ibus": {
        "engine": "xkb:us::eng"
      }
    }
  },
  "probe": null,
  "actions": [
    {
      "xdotool": ["key", "a"]
    }
  ],
  "ground_truth": {
    "fired": {
      "sh": "false"
    },
    "delivered": {
      "typed": "a"
    },
    "reached": {
      "typed": "a"
    }
  },
  "whykey": {
    "args": ["a"],
    "layer": "Input method",
    "summary": "xkb:us::eng is a plain keyboard layout",
    "env": {
      "XDG_CURRENT_DESKTOP": "x11",
      "XDG_SESSION_TYPE": "x11"
    }
  }
}
