{
  "id": "tmux-unbound",
  "description": "a key with no tmux binding reaches the shell in the pane",
  "tier": "observed",
  "environment": "pty",
  "files": {
    "/root/.tmux.conf": ["set -g status off"],
    "/root/.bashrc": [
      "PS1='$ '",
      "bind -x '\"\\C-t\": touch /tmp/reached-shell'",
      "bind -x '\"\\C-b\": touch /tmp/reached-shell'"
    ]
  },
  "pty": {
    "command": ["tmux", "-f", "/root/.tmux.conf", "new-session", "-s", "lab", "bash", "-i"],
    "env": {"SHELL": "/usr/bin/bash"}
  },
  "actions": [{"type": "\\x14"}],
  "ground_truth": {"fired": {"file": "/tmp/fired"}, "delivered": {"file": "/tmp/reached-shell"}},
  "whykey": {"args": ["ctrl+t"], "layer": "tmux", "run": "pty"}
}
