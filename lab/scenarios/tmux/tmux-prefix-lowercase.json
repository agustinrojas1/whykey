{
  "id": "tmux-prefix-lowercase",
  "description": "prefix C-Space then c runs the lowercase `bind c`, not `bind C` (tmux keys are case-sensitive; list-keys prints C first)",
  "tier": "observed",
  "environment": "pty",
  "files": {
    "/root/.tmux.conf": [
      "set -g prefix C-Space",
      "set -g prefix2 C-b",
      "set -g status off",
      "set -sg escape-time 10",
      "bind C run-shell 'touch /tmp/wrong'",
      "bind c run-shell 'touch /tmp/fired'"
    ],
    "/root/.bashrc": [
      "PS1='$ '"
    ]
  },
  "pty": {
    "command": [
      "tmux",
      "-f",
      "/root/.tmux.conf",
      "new-session",
      "-s",
      "lab",
      "bash",
      "-i"
    ],
    "env": {
      "SHELL": "/usr/bin/bash"
    }
  },
  "actions": [
    {
      "type": "echo a"
    },
    {
      "type": "\\x00"
    },
    {
      "type": "c"
    },
    {
      "type": "b > /tmp/effect\\r"
    },
    {
      "sleep": 0.5
    }
  ],
  "ground_truth": {
    "fired": {
      "file": "/tmp/fired"
    },
    "delivered": {
      "sh": "! grep -qx ab /tmp/effect"
    },
    "reached": {
      "file": "/tmp/effect"
    }
  },
  "whykey": {
    "args": [
      "inspect",
      "ctrl+space",
      "c"
    ],
    "layer": "tmux",
    "run": "pty",
    "detail": "touch /tmp/fired"
  }
}
