{
  "id": "tmux-root-alt-escape",
  "description": "root `bind -n M-Escape` (as in the Omarchy tmux.conf) consumes Alt+Escape; the generic terminal fallback has no Alt+Escape encoding, so whykey honestly marks byte delivery unverified",
  "tier": "observed",
  "environment": "pty",
  "files": {
    "/root/.tmux.conf": [
      "set -g prefix C-Space",
      "set -g prefix2 C-b",
      "set -g status off",
      "set -sg escape-time 10",
      "bind -n M-Escape run-shell 'touch /tmp/fired'"
    ],
    "/root/.bashrc": [
      "PS1='$ '",
      "bind -x '\"\\e\\e\": touch /tmp/reached-shell'"
    ]
  },
  "pty": {
    "command": [
      "tmux",
      "-f",
      "/root/.tmux.conf",
      "new-session",
      "-s",
      "lab",
      "bash",
      "-i"
    ],
    "env": {
      "SHELL": "/usr/bin/bash"
    }
  },
  "actions": [
    {
      "type": "\\e\\e"
    },
    {
      "sleep": 0.5
    }
  ],
  "ground_truth": {
    "fired": {
      "file": "/tmp/fired"
    },
    "delivered": {
      "file": "/tmp/reached-shell"
    }
  },
  "whykey": {
    "args": [
      "alt+escape"
    ],
    "layer": "tmux",
    "run": "pty",
    "detail": "touch /tmp/fired",
    "accept": [
      "handled-uncertain"
    ]
  }
}
