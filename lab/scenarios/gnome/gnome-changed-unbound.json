{
  "id": "gnome-changed-unbound",
  "description": "after rebinding close to <Super>F9, Alt+F4 is no longer a mutter binding and reaches the probe window",
  "tier": "observed",
  "environment": "gnome",
  "session_setup": [
    "gsettings set org.gnome.desktop.wm.keybindings close \"['<Super>F9']\""
  ],
  "probe": "wayland",
  "actions": [
    {
      "sleep": 0.5
    },
    {
      "rdkbd": [
        "alt+F4"
      ]
    }
  ],
  "ground_truth": {
    "fired": {
      "sh": "! pgrep -f 'lab/[k]eylog.py'"
    },
    "delivered": "probe"
  },
  "whykey": {
    "args": [
      "alt+F4"
    ],
    "layer": "GNOME"
  }
}
