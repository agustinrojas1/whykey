{
  "id": "gnome-changed-bound",
  "description": "after `gsettings set ... close ['<Super>F9']`, mutter closes the focused window on Super+F9",
  "tier": "observed",
  "environment": "gnome",
  "session_setup": [
    "gsettings set org.gnome.desktop.wm.keybindings close \"['<Super>F9']\""
  ],
  "probe": "wayland",
  "actions": [
    {
      "sleep": 0.5
    },
    {
      "rdkbd": [
        "super+F9"
      ]
    }
  ],
  "ground_truth": {
    "fired": {
      "sh": "! pgrep -f 'lab/[k]eylog.py'"
    },
    "delivered": "probe"
  },
  "whykey": {
    "args": [
      "super+F9"
    ],
    "layer": "GNOME",
    "detail": "org.gnome.desktop.wm.keybindings close = '<Super>F9'"
  }
}
