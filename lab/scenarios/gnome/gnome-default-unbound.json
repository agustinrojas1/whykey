{
  "id": "gnome-default-unbound",
  "description": "<Super>y has no default GNOME binding: mutter delivers it to the focused probe window",
  "tier": "observed",
  "environment": "gnome",
  "probe": "wayland",
  "actions": [
    {
      "rdkbd": [
        "super+y"
      ]
    }
  ],
  "ground_truth": {
    "fired": {
      "sh": "! pgrep -f 'lab/[k]eylog.py'"
    },
    "delivered": "probe"
  },
  "whykey": {
    "args": [
      "super+y"
    ],
    "layer": "GNOME"
  }
}
