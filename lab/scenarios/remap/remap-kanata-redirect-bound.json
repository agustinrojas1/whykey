{
  "id": "remap-kanata-redirect-bound",
  "description": "kanata (v1.12.0, -c /root/kanata.kbd) maps F9 to F12 with defsrc/deflayer on the VM kernel keyboard; the Input remapper layer reports the redirect, and Hyprland's bind on F12 fires and consumes the key",
  "tier": "observed",
  "environment": "remap",
  "remap": {"daemon": {"argv": ["kanata", "-c", "/root/kanata.kbd"], "ready": "kanata"}},
  "files": {
    "/root/kanata.kbd": ["(defcfg)", "(defsrc f9)", "(deflayer base f12)"],
    "/root/.config/hypr/hyprland.lua": [
      "hl.bind(\"F12\", hl.dsp.exec_cmd(\"touch /tmp/fired\"), { description = \"Lab fire\" })"
    ]
  },
  "probe": "wayland",
  "actions": [
    {"qkbd": ["f9"]}
  ],
  "ground_truth": {
    "fired": {"file": "/tmp/fired"},
    "delivered": "probe"
  },
  "whykey": {
    "args": ["f9"],
    "layer": ["Hyprland"],
    "via": {"layer": "Input remapper", "summary": "F9", "binding": "F12"},
    "env": {"XDG_CURRENT_DESKTOP": "Hyprland", "XDG_SESSION_TYPE": "wayland"}
  }
}
