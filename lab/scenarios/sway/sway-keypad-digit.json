{
  "id": "sway-keypad-digit",
  "description": "bindsym Mod4+KP_1 fires with NumLock on: Sway matches the translated keysym with the NumLock modifier consumed",
  "tier": "observed",
  "environment": "sway",
  "files": {
    "/root/.config/sway/config": [
      "bindsym Mod4+KP_1 exec touch /tmp/fired"
    ]
  },
  "probe": "wayland",
  "actions": [
    {
      "vkbd": [
        "--numlock",
        "super+kp_1"
      ]
    }
  ],
  "ground_truth": {
    "fired": {
      "file": "/tmp/fired"
    },
    "delivered": "probe"
  },
  "whykey": {
    "args": [
      "super+kp_1"
    ],
    "layer": "Sway",
    "env": {
      "XDG_CURRENT_DESKTOP": "sway",
      "XDG_SESSION_TYPE": "wayland"
    }
  }
}
