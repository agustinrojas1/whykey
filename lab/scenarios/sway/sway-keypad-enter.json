{
  "id": "sway-keypad-enter",
  "description": "bindsym Mod4+KP_Enter fires for keypad Enter and Mod4+Return does not",
  "tier": "observed",
  "environment": "sway",
  "files": {
    "/root/.config/sway/config": [
      "bindsym Mod4+Return exec touch /tmp/return",
      "bindsym Mod4+KP_Enter exec touch /tmp/fired"
    ]
  },
  "probe": "wayland",
  "actions": [
    {
      "vkbd": [
        "super+kp_enter"
      ]
    }
  ],
  "ground_truth": {
    "fired": {
      "sh": "test -e /tmp/fired && test ! -e /tmp/return"
    },
    "delivered": "probe"
  },
  "whykey": {
    "args": [
      "super+kp_enter"
    ],
    "layer": "Sway",
    "detail": "exec touch /tmp/fired",
    "env": {
      "XDG_CURRENT_DESKTOP": "sway",
      "XDG_SESSION_TYPE": "wayland"
    }
  }
}
