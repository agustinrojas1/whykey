{
  "id": "sway-plain-bind-wtype",
  "description": "bindsym Mod4+t fires from wtype (virtual keyboard with its own keymap)",
  "tier": "observed",
  "environment": "sway",
  "files": {"/root/.config/sway/config": ["bindsym Mod4+t exec touch /tmp/fired"]},
  "probe": "wayland",
  "actions": [{"wtype": ["-M", "logo", "-k", "t", "-m", "logo"]}],
  "ground_truth": {"fired": {"file": "/tmp/fired"}, "delivered": "probe"},
  "whykey": {
    "args": ["super+t"],
    "layer": "Sway",
    "env": {"XDG_CURRENT_DESKTOP": "sway", "XDG_SESSION_TYPE": "wayland"}
  }
}
