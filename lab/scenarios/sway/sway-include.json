{
  "id": "sway-include",
  "description": "a binding from an included file fires",
  "tier": "observed",
  "environment": "sway",
  "files": {
    "/root/.config/sway/config": ["include /root/.config/sway/config.d/*"],
    "/root/.config/sway/config.d/keys": ["bindsym Mod4+t exec touch /tmp/fired"]
  },
  "probe": "wayland",
  "actions": [{"vkbd": ["super+t"]}],
  "ground_truth": {"fired": {"file": "/tmp/fired"}, "delivered": "probe"},
  "whykey": {
    "args": ["super+t"],
    "layer": "Sway",
    "env": {"XDG_CURRENT_DESKTOP": "sway", "XDG_SESSION_TYPE": "wayland"}
  }
}
