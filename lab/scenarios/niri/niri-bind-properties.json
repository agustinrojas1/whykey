{
  "id": "niri-bind-properties",
  "description": "a Super+T bind with allow-when-locked=true and repeat=false properties runs its command and the key is consumed; the properties do not change the key, so tolerated uncertainty as with niri-bind-consumed",
  "tier": "observed",
  "environment": "niri",
  "files": {
    "/root/.config/niri/config.kdl": [
      "binds {",
      "    Super+T allow-when-locked=true repeat=false { spawn \"sh\" \"-c\" \"touch /tmp/fired\"; }",
      "}"
    ]
  },
  "probe": "wayland",
  "actions": [{"outer_vkbd": ["super+t"]}],
  "ground_truth": {"fired": {"file": "/tmp/fired"}, "delivered": "probe"},
  "whykey": {
    "args": ["super+t"],
    "layer": "Niri",
    "accept": ["handled-uncertain"],
    "env": {"XDG_CURRENT_DESKTOP": "niri", "XDG_SESSION_TYPE": "wayland"}
  }
}
