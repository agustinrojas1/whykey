{
  "id": "konsole-ctrl-left",
  "description": "a Konsole keytab sends ctrl+left as CSI 1;5D and the program receives exactly those bytes",
  "tier": "observed",
  "environment": "terminals",
  "terminal": "konsole",
  "files": {
    "/root/.config/konsolerc": ["[Desktop Entry]", "DefaultProfile=whykey.profile"],
    "/root/.local/share/konsole/whykey.profile": ["[General]", "Name=whykey", "[Keyboard]", "KeyBindings=whykey"],
    "/root/.local/share/konsole/whykey.keytab": ["keyboard \"whykey\"", "key Left +Ctrl : \"\\E[1;5D\""]
  },
  "actions": [
    {"tty_log": "start"},
    {"vkbd": ["ctrl+left"]},
    {"tty_log": "stop"}
  ],
  "ground_truth": {"fired": {"file": "/tmp/fired"}, "delivered": {"tty_input": {"equals": "\\x1b[1;5D"}}},
  "whykey": {"args": ["ctrl+left"], "layer": "Konsole"}
}
