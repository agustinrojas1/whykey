{
  "id": "kitty-alt-x",
  "description": "unbound alt+x reaches a kitty program as ESC x",
  "tier": "observed",
  "environment": "terminals",
  "terminal": "kitty",
  "files": {"/root/.config/kitty/kitty.conf": ["allow_remote_control no"]},
  "actions": [
    {"tty_log": "start"},
    {"vkbd": ["alt+x"]},
    {"tty_log": "stop"}
  ],
  "ground_truth": {"fired": {"file": "/tmp/fired"}, "delivered": {"tty_input": {"equals": "\\x1bx"}}},
  "whykey": {"args": ["alt+x"], "layer": "Kitty"}
}
