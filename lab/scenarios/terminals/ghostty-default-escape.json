{
  "id": "ghostty-default-escape",
  "description": "Ghostty's default keybindings do not consume escape when there is nothing to act on: the program receives it",
  "tier": "observed",
  "environment": "terminals",
  "terminal": "ghostty",
  "files": {"/root/.config/ghostty/config": ["# whykey lab: no keybinds"]},
  "actions": [
    {"tty_log": "start"},
    {"vkbd": ["escape"]},
    {"tty_log": "stop"}
  ],
  "ground_truth": {"fired": {"file": "/tmp/fired"}, "delivered": {"tty_input": {"equals": "\\x1b"}}},
  "whykey": {"args": ["escape"], "layer": "Ghostty", "accept": ["uncertain-continues"]}
}
