{
  "id": "foot-default-font-increase",
  "description": "foot's built-in Control+equal enlarges the font with no [key-bindings] entry, and foot consumes the key",
  "tier": "observed",
  "environment": "terminals",
  "terminal": "foot",
  "files": {
    "/root/.config/foot/foot.ini": ["[main]", "term=foot"]
  },
  "actions": [
    {"term_sh": "stty size > /tmp/size-before"},
    {"tty_log": "start"},
    {"vkbd": ["ctrl+equal"]},
    {"sleep": 1},
    {"tty_log": "stop"},
    {"term_sh": "stty size > /tmp/size-after"}
  ],
  "ground_truth": {
    "fired": {"sh": "! cmp -s /tmp/size-before /tmp/size-after"},
    "delivered": {"tty_input": {"any": true}}
  },
  "whykey": {"args": ["ctrl+equal"], "layer": "Foot", "summary": "consumes", "detail": "Foot 1.28.0 default"}
}
