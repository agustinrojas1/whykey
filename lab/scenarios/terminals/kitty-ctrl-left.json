{
  "id": "kitty-ctrl-left",
  "description": "unbound ctrl+left reaches a kitty program as CSI 1;5D",
  "tier": "observed",
  "environment": "terminals",
  "terminal": "kitty",
  "files": {"/root/.config/kitty/kitty.conf": ["allow_remote_control no"]},
  "actions": [
    {"tty_log": "start"},
    {"vkbd": ["ctrl+left"]},
    {"tty_log": "stop"}
  ],
  "ground_truth": {"fired": {"file": "/tmp/fired"}, "delivered": {"tty_input": {"equals": "\\x1b[1;5D"}}},
  "whykey": {"args": ["ctrl+left"], "layer": "Kitty"}
}
