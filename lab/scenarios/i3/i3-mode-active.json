{
  "id": "i3-mode-active",
  "description": "a binding of the active mode fires while that mode is entered",
  "tier": "observed",
  "environment": "x11",
  "files": {
    "/root/.config/i3/config": [
      "bindsym Mod4+r mode lab",
      "mode lab {",
      "    bindsym t exec touch /tmp/fired",
      "    bindsym Escape mode default",
      "}"
    ]
  },
  "x11": {
    "daemons": [
      {
        "argv": ["i3", "-c", "/root/.config/i3/config"],
        "ready": "wm",
        "ready_grab": [64, 27]
      }
    ]
  },
  "probe": "x11",
  "actions": [{"xdotool": ["key", "Super_L+r"]}, {"xdotool": ["key", "t"]}],
  "ground_truth": {"fired": {"file": "/tmp/fired"}, "delivered": "probe"},
  "whykey": {
    "args": ["t"],
    "layer": "i3",
    "env": {"XDG_SESSION_TYPE": "x11", "XDG_CURRENT_DESKTOP": "i3"}
  }
}
