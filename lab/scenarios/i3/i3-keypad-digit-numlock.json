{
  "id": "i3-keypad-digit-numlock",
  "description": "bindsym $mod+Mod2+KP_1: i3 resolves KP_1 at the NumLock level and grabs the keypad End keycode with Mod4+Mod2; with NumLock on the bind fires and i3 consumes the key",
  "tier": "observed",
  "environment": "x11",
  "files": {
    "/root/.config/i3/config": [
      "set $mod Mod4",
      "bindsym $mod+Mod2+KP_1 exec touch /tmp/fired"
    ]
  },
  "x11": {
    "daemons": [
      {
        "argv": [
          "i3",
          "-c",
          "/root/.config/i3/config"
        ],
        "ready": "wm",
        "ready_grab": [
          80,
          87
        ]
      }
    ]
  },
  "probe": "x11",
  "actions": [
    {
      "xdotool": [
        "key",
        "Num_Lock"
      ]
    },
    {
      "xdotool": [
        "key",
        "Super_L+KP_1"
      ]
    }
  ],
  "ground_truth": {
    "fired": {
      "file": "/tmp/fired"
    },
    "delivered": "probe"
  },
  "whykey": {
    "args": [
      "super+kp_1"
    ],
    "layer": "i3",
    "env": {
      "XDG_SESSION_TYPE": "x11",
      "XDG_CURRENT_DESKTOP": "i3"
    },
    "detail": "bindsym Mod4+Mod2+KP_1"
  }
}
