{
  "id": "i3-plain-bind",
  "description": "bindsym Mod4+t fires and i3 consumes the key",
  "tier": "observed",
  "environment": "x11",
  "files": {"/root/.config/i3/config": ["bindsym Mod4+t exec touch /tmp/fired"]},
  "x11": {
    "daemons": [
      {
        "argv": ["i3", "-c", "/root/.config/i3/config"],
        "ready": "wm",
        "ready_grab": [64, 28]
      }
    ]
  },
  "probe": "x11",
  "actions": [{"xdotool": ["key", "Super_L+t"]}],
  "ground_truth": {"fired": {"file": "/tmp/fired"}, "delivered": "probe"},
  "whykey": {
    "args": ["super+t"],
    "layer": "i3",
    "env": {"XDG_SESSION_TYPE": "x11", "XDG_CURRENT_DESKTOP": "i3"}
  }
}
