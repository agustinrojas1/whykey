{
  "id": "zellij-default-alt-n",
  "description": "Alt-n is Zellij's built-in normal-mode NewPane binding (no user binding); the key opens a second pane, so the first pane's shell never receives it; whykey is told the mode with WHYKEY_ZELLIJ_MODE=normal",
  "tier": "observed",
  "environment": "pty",
  "files": {
    "/root/.config/zellij/config.kdl": [
      "show_release_notes false",
      "show_startup_tips false"
    ],
    "/root/.bashrc": [
      "PS1='$ '",
      "echo started >> /tmp/shells-started",
      "bind -x '\"\\C-v\": touch /tmp/reached-shell'",
      "bind -x '\"\\C-y\": touch /tmp/reached-shell'",
      "bind -x '\"\\en\": touch /tmp/reached-shell'"
    ]
  },
  "pty": {
    "command": [
      "zellij",
      "-s",
      "lab"
    ],
    "env": {
      "SHELL": "/usr/bin/bash"
    },
    "settle": 3
  },
  "actions": [
    {
      "sleep": 1
    },
    {
      "type": "\\en"
    },
    {
      "sleep": 2
    }
  ],
  "ground_truth": {
    "fired": {
      "sh": "test \"$(wc -l < /tmp/shells-started)\" -ge 2"
    },
    "delivered": {
      "file": "/tmp/reached-shell"
    }
  },
  "whykey": {
    "args": [
      "alt+n"
    ],
    "layer": "Zellij",
    "run": "pty",
    "command": "WHYKEY_ZELLIJ_MODE=normal /w/whykey"
  }
}
