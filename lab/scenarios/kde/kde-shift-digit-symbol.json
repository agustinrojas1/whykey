{
  "id": "kde-shift-digit-symbol",
  "description": "a kglobalaccel shortcut stored as the shifted symbol (Meta+!, as KDE records Super+Shift+1) fires for Super+Shift+1; whykey matches shift+1 against `!` assuming a US layout",
  "tier": "observed",
  "environment": "x11",
  "files": {
    "/root/.local/share/applications/lab-fire.desktop": [
      "[Desktop Entry]",
      "Type=Application",
      "Name=Lab fire",
      "Exec=touch /tmp/fired"
    ],
    "/root/.config/kglobalshortcutsrc": [
      "[services][lab-fire.desktop]",
      "_launch=Meta+!"
    ]
  },
  "x11": {
    "daemons": [
      {
        "argv": [
          "/usr/libexec/kglobalacceld"
        ],
        "env": {
          "QT_QPA_PLATFORM": "xcb"
        },
        "ready_grab": [
          65,
          10
        ]
      }
    ]
  },
  "probe": "x11",
  "actions": [
    {
      "xdotool": [
        "key",
        "Super_L+shift+1"
      ]
    }
  ],
  "ground_truth": {
    "fired": {
      "file": "/tmp/fired"
    },
    "delivered": "probe"
  },
  "whykey": {
    "args": [
      "super+shift+1"
    ],
    "layer": "KDE Plasma",
    "env": {
      "XDG_SESSION_TYPE": "x11",
      "XDG_CURRENT_DESKTOP": "KDE",
      "KDE_FULL_SESSION": "true",
      "KDE_SESSION_VERSION": "6"
    }
  }
}
