{
  "id": "zsh-default-transpose-noinit",
  "description": "zsh's own ctrl+t (transpose-chars) edits the line; $SHELL is bash",
  "tier": "observed",
  "environment": "pty",
  "files": {
    "/root/.zshrc": [
      "PS1='%% '"
    ]
  },
  "pty": {
    "command": [
      "zsh",
      "-i"
    ],
    "env": {
      "SHELL": "/usr/bin/bash"
    }
  },
  "actions": [
    {
      "type": "echo ab"
    },
    {
      "type": "\\x14"
    },
    {
      "type": " > /tmp/effect\\r"
    }
  ],
  "ground_truth": {
    "fired": {
      "file": "/tmp/effect",
      "equals": "ba"
    },
    "reached": "fired"
  },
  "whykey": {
    "args": [
      "ctrl+t"
    ],
    "layer": "Zsh / ZLE",
    "run": "pty",
    "summary": "bound to transpose-chars",
    "accept": [
      "handled-uncertain"
    ]
  }
}
