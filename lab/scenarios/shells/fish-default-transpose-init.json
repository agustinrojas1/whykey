{
  "id": "fish-default-transpose-init",
  "description": "fish's preset ctrl+t (transpose-chars) edits the line; $SHELL is bash",
  "tier": "observed",
  "environment": "pty",
  "files": {
    "/root/.config/fish/config.fish": [
      "function fish_prompt; echo -n '> '; end",
      "whykey shell-init fish | source"
    ]
  },
  "pty": {
    "command": [
      "fish",
      "-i"
    ],
    "env": {
      "SHELL": "/usr/bin/bash"
    }
  },
  "actions": [
    {
      "type": "echo ab"
    },
    {
      "type": "\\x14"
    },
    {
      "type": " > /tmp/effect\\r"
    }
  ],
  "ground_truth": {
    "fired": {
      "file": "/tmp/effect",
      "equals": "ba"
    },
    "reached": "fired"
  },
  "whykey": {
    "args": [
      "ctrl+t"
    ],
    "layer": "Fish",
    "run": "pty",
    "summary": "bound to transpose-chars"
  }
}
