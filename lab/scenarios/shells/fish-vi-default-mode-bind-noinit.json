{
  "id": "fish-vi-default-mode-bind-noinit",
  "description": "with fish_vi_key_bindings, a plain `bind ctrl-t` belongs to mode default (normal) and does not fire at the insert prompt; fish's line editor reads ^T and drops it (the bytes typed before and after it reach the executed command line)",
  "tier": "observed",
  "environment": "pty",
  "files": {
    "/root/.config/fish/config.fish": [
      "function fish_prompt; echo -n '> '; end",
      "fish_vi_key_bindings",
      "bind ctrl-t 'touch /tmp/fired'"
    ]
  },
  "pty": {
    "command": [
      "fish",
      "-i"
    ],
    "env": {
      "SHELL": "/usr/bin/bash"
    }
  },
  "actions": [
    {
      "type": "echo ab"
    },
    {
      "type": "\\x14"
    },
    {
      "type": "cd > /tmp/effect\\r"
    },
    {
      "sleep": 0.5
    }
  ],
  "ground_truth": {
    "fired": {
      "file": "/tmp/fired"
    },
    "reached": {
      "file": "/tmp/effect",
      "equals": "abcd"
    }
  },
  "whykey": {
    "args": [
      "ctrl+t"
    ],
    "layer": "Fish",
    "run": "pty",
    "summary": "not bound in bind mode insert",
    "accept": [
      "uncertain-continues"
    ]
  }
}
