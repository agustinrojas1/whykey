{
  "id": "sxhkd-replay-plain",
  "description": "a ~t binding (no modifier) fires and sxhkd replays t to the focused client",
  "tier": "observed",
  "environment": "x11",
  "files": {"/root/.config/sxhkd/sxhkdrc": ["~t", "    touch /tmp/fired"]},
  "x11": {"daemons": [{"argv": ["sxhkd", "-c", "/root/.config/sxhkd/sxhkdrc"], "ready_grab": [0, 28]}]},
  "probe": "x11",
  "actions": [{"xdotool": ["key", "t"]}],
  "ground_truth": {"fired": {"file": "/tmp/fired"}, "delivered": "probe"},
  "whykey": {"args": ["t"], "layer": "sxhkd", "summary": "replays the key", "env": {"XDG_SESSION_TYPE": "x11"}}
}
