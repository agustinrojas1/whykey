{
  "id": "sxhkd-replay",
  "description": "a ~super + t binding fires and sxhkd replays the key to the focused client",
  "tier": "observed",
  "environment": "x11",
  "files": {"/root/.config/sxhkd/sxhkdrc": ["~super + t", "    touch /tmp/fired"]},
  "x11": {"daemons": [{"argv": ["sxhkd", "-c", "/root/.config/sxhkd/sxhkdrc"], "ready_grab": [64, 28]}]},
  "probe": "x11",
  "actions": [{"xdotool": ["key", "Super_L+t"]}],
  "ground_truth": {"fired": {"file": "/tmp/fired"}, "delivered": "probe"},
  "whykey": {"args": ["super+t"], "layer": "sxhkd", "summary": "replays the key", "env": {"XDG_SESSION_TYPE": "x11"}}
}
