{
  "id": "sxhkd-bind",
  "description": "an sxhkdrc binding super + t fires (no window manager)",
  "tier": "observed",
  "environment": "x11",
  "files": {"/root/.config/sxhkd/sxhkdrc": ["super + t", "    touch /tmp/fired"]},
  "x11": {
    "daemons": [{"argv": ["sxhkd", "-c", "/root/.config/sxhkd/sxhkdrc"], "ready_grab": [64, 28]}]
  },
  "probe": "x11",
  "actions": [{"xdotool": ["key", "Super_L+t"]}],
  "ground_truth": {"fired": {"file": "/tmp/fired"}, "delivered": "probe"},
  "whykey": {"args": ["super+t"], "layer": "sxhkd", "env": {"XDG_SESSION_TYPE": "x11"}}
}
