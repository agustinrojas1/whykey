{
  "id": "sxhkd-continuation-past-text",
  "description": "a continued command moves the shared offset past the empty hotkey buffer, so the next hotkey line `super + t` is written after its NUL and never binds",
  "tier": "observed",
  "environment": "x11",
  "files": {"/root/.config/sxhkd/sxhkdrc": ["  touch /tmp/\\", "super + t", "  touch /tmp/fired", "super + y", "  touch /tmp/ready"]},
  "x11": {"daemons": [{"argv": ["sxhkd", "-c", "/root/.config/sxhkd/sxhkdrc"], "ready_grab": [64, 29]}]},
  "probe": "x11",
  "actions": [{"xdotool": ["key", "Super_L+t"]}],
  "ground_truth": {"fired": {"file": "/tmp/fired"}, "delivered": "probe"},
  "whykey": {"args": ["super+t"], "layer": "sxhkd", "env": {"XDG_SESSION_TYPE": "x11"}}
}
