#!/usr/bin/env python3
"""Deterministic hyprctl stand-in for adapter fixture tests."""

import json
import os
import sys

if os.environ.get("WHYKEY_FAKE_IPC_FAILURE"):
    print("fake hyprctl IPC failure", file=sys.stderr)
    raise SystemExit(1)
if sys.argv[1:] == ["submap", "-j"]:
    print(json.dumps(os.environ.get("WHYKEY_FAKE_SUBMAP", "default")))
elif sys.argv[1:] == ["submap"]:
    print(os.environ.get("WHYKEY_FAKE_SUBMAP", "default"))
elif sys.argv[1:] == ["binds", "-j"]:
    print("[]")
else:
    print("ok")
