// VS Code user keybindings fixture
[
    /* exact match */
    {
        "key": "ctrl+x",
        "command": "test.exact"
    },
    /* conditional when match */
    {
        "key": "ctrl+y",
        "command": "test.conditional",
        "when": "editorTextFocus"
    },
    /* chord prefix */
    {
        "key": "ctrl+k ctrl+c",
        "command": "test.chord"
    },
    /* user binding plus a removal: `-command` removes default bindings only, so test.removed stays */
    {
        "key": "ctrl+z",
        "command": "test.removed"
    },
    {
        "key": "ctrl+z",
        "command": "-test.removed"
    },
    /* removes VS Code's only default binding of F1 */
    {
        "key": "f1",
        "command": "-workbench.action.showCommands"
    }
]
