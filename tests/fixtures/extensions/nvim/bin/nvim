#!/usr/bin/env python3
"""Stub nvim binary for hermetic whykey extension testing."""

import sys

args = sys.argv[1:]
expr = ""
for i, arg in enumerate(args):
    if arg == "--remote-expr" and i + 1 < len(args):
        expr = args[i + 1]
    elif arg.startswith("--remote-expr="):
        expr = arg.split("=", 1)[1]

if "<C-x>" in expr:
    sys.stdout.write("n\t:echo 1<CR>\t1\n")
elif "<C-Left>" in expr:
    sys.stdout.write("i\tcopilot#Accept()\t0\n")
elif "<C-S-X>" in expr:
    sys.stdout.write("n\t<Plug>(Custom)\t0\n")
elif "<C-q>" in expr:
    sys.stdout.write("n\t\t0\n")
else:
    sys.stdout.write("n\t\t0\n")
